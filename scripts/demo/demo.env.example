# Copy to the repo-root .env (docker compose reads that) or export before
# starting the backend. See docs/demo/DEMO_SCRIPT.md and scripts/demo/TIMEOUTS.md.

# Backend API the setup/scenario scripts call
SRSE_API_BASE=http://localhost:8080

# Super Admin (bootstrap or existing). Override if your .env used another password.
DEMO_SUPERADMIN_USER=superadmin
DEMO_SUPERADMIN_PASSWORD=Supradmin@123

# Documented officer passwords from docs/RUNNING_LOCALLY.md
DEMO_JAIPUR_OFFICER_PASSWORD=JaiOffic$1x
DEMO_SANGANER_PASSWORD=Officer$New1
DEMO_JAIPUR_ADMIN_PASSWORD=JaipurNew$1

# Data Source JDBC — host/port as the *backend* sees Postgres.
# Host-run backend: localhost:5433
# Backend in docker compose: postgres:5432
DEMO_DATASOURCE_HOST=localhost
DEMO_DATASOURCE_PORT=5433
DEMO_DATASOURCE_DB=analytics_demo
DEMO_DATASOURCE_USER=demo_ro
DEMO_DATASOURCE_PASSWORD=demo_ro_dev_pw

# Officer-facing Presto catalog used for scoped Query Builder registrations
DEMO_PRESTO_CATALOG=demo_pg
DEMO_PRESTO_SCHEMA=demo

# OTP: docker:<container>  or  file:</path/to/backend.log>
DEMO_OTP_SOURCE=docker:srse-backend

# 20-minute fuzzy (the only guardrail we raise)
SRSE_QUERY_TIMEOUT_SECONDS=1200
# Tomcat/Spring async default is 30s and would cut a long NDJSON stream first
SPRING_MVC_ASYNC_REQUEST_TIMEOUT=1260000
