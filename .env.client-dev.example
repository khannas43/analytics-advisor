# Client Dev environment — copy to .env (or export) before:
#   docker compose -f docker-compose.yml -f docker-compose.client-dev.yml up srse-backend srse-frontend
#
# Real on-prem values are pending (CLAUDE.md open items):
#   - Golden Layer / Presto endpoint + DB2 placement — Lovadeep / DBA
#   - RajSewadwar SSO / STATE_OFFICER RBAC — Arvind
# Do NOT invent hostnames or credentials; fill these in once confirmed.

# ---- Operational plane: on-prem PostgreSQL or DB2 ----
CLIENT_OPERATIONAL_JDBC_URL=jdbc:db2://CHANGE_ME:50000/SRSEDB
CLIENT_OPERATIONAL_USER=CHANGE_ME
CLIENT_OPERATIONAL_PASSWORD=CHANGE_ME
# Omit or set to org.postgresql.Driver for PostgreSQL
CLIENT_OPERATIONAL_DRIVER=com.ibm.db2.jcc.DB2Driver

# ---- Analytical plane: on-prem PrestoDB 0.297 ----
# Driver: com.facebook.presto:presto-jdbc  (NOT Trino)
CLIENT_PRESTO_URL=jdbc:presto://CHANGE_ME:8080/iceberg/srse
CLIENT_PRESTO_USER=CHANGE_ME
CLIENT_PRESTO_PASSWORD=CHANGE_ME
# SSL defaults to true for client-dev (docker-compose.client-dev.yml) — set
# CLIENT_PRESTO_SSL=false only if this specific on-prem endpoint genuinely
# has no TLS. Trust-store vars are only read when SSL is true.
CLIENT_PRESTO_SSL=true
CLIENT_PRESTO_TRUSTSTORE_PATH=CHANGE_ME
CLIENT_PRESTO_TRUSTSTORE_PASSWORD=CHANGE_ME

# ---- Schema/table names ----
# The operational table and most column names (district, gender, age_years,
# etc.) are NOT set here — they're resolved per field via the Admin tab's
# field-mapping screen (field_column_mapping, DataMode=LIVE), so the same
# image works against any Golden Layer table name with zero redeploy. The one
# exception is age_band (Rule Engine breakdown dimension only, never an
# officer-selectable field, so it has no catalogue entry to hang a mapping off):
CLIENT_AGE_BAND_COLUMN=CHANGE_ME
